# cowrie-digest configuration
# Copy this file to config.env and fill in your values.

# Delivery channel: "ntfy" or "telegram"
CHANNEL=ntfy

# --- ntfy.sh settings (channel=ntfy) ---
# Pick a long, unguessable topic name — anyone who knows it can read your alerts.
NTFY_TOPIC=cowrie-alerts-CHANGE-ME-long-random-string
NTFY_SERVER=https://ntfy.sh

# --- Telegram settings (channel=telegram) ---
# Create a bot via @BotFather, then get your chat_id (e.g. via @userinfobot)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Cowrie paths ---
COWRIE_LOG=/opt/cowrie/var/log/cowrie/cowrie.json

# --- Module state (timestamps, markers) ---
STATE_DIR=/opt/cowrie/ops/01-digest/state

# --- Report behavior ---
# Hours covered by --digest
DIGEST_HOURS=24
# Sensor name shown in reports (useful if you run several honeypots)
SENSOR_NAME=srv04

# --- Pseudonymization (compliance: raw IPs never leave the server) ---
# Replace every IPv4 in outbound messages with a stable HMAC-SHA256
# pseudonym (ip-xxxxxxxxxxxx). Keep this ON.
PSEUDO_ENABLED=true
# HMAC key (hex, generated by install.sh). Never commit, never share.
PSEUDO_KEY_PATH=/opt/cowrie/ops/secrets/pseudo.key
